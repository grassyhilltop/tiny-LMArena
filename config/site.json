{
  "site_name": "tiny-LMArena",
  "repo": "grassyhilltop/tiny-LMArena",
  "site_url": "https://grassyhilltop.github.io/tiny-LMArena/",
  "author": "Joel Sadler",
  "affiliation": "University of Virginia, School of Data Science",
  "slm_rule": {
    "vram_gb": 32,
    "bytes_per_param_4bit": 0.5,
    "weights_share_of_vram": 0.75,
    "note": "An SLM is an open-weight model whose 4-bit weights fill at most 75% of a 32 GB GPU: 0.5 GB per billion parameters, so at most 48B total parameters."
  },
  "anthropic_class_max_b": 31,
  "fit": {
    "interval": 0.90,
    "windows": {"since2023": "2023-07-01", "last24": "-730"}
  },
  "thresholds": [
    {"key": "selfrep", "kind": "model", "model": "GLM-5.2",
     "label": "Self-replication floor",
     "short": "self-replication floor",
     "anthropic_value": 151.8,
     "source": "https://www.anthropic.com/research/self-replicating-ai"},
    {"key": "frontier1y", "kind": "frontier_ago", "days": 365,
     "label": "Frontier one year ago",
     "short": "frontier of a year ago"},
    {"key": "frontier", "kind": "frontier_now",
     "label": "Today's frontier",
     "short": "today's frontier"}
  ],
  "newsletter": {
    "provider": "buttondown",
    "username": "",
    "send_alerts": false
  }
}
